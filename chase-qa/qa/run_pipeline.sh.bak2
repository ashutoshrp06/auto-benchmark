#!/bin/bash
# Full CHASE-Finance generation pipeline, stages 1-10, with optional sharding.
#
#   ./run_pipeline.sh -n v7 -m gpt-5.4-mini                              # unsharded
#   ./run_pipeline.sh -n v7 -m gpt-5.4-mini --shards 12                  # 12 concurrent shards
#   ./run_pipeline.sh -n v7 -m gpt-5.4-mini --shards 12 --max-parallel 6
#   ./run_pipeline.sh -n v7 -m gpt-5.4-mini --shards 12 --qa-iters 4 --qa-iters-t3 6
#   ./run_pipeline.sh -n v7 -m gpt-5.4-mini --shards 12 --from 4
#
# Stage 1 and stage 10 always run unsharded. Stages 2-9 run once per shard over
# an independent directory chain. Outputs are merged after stage 9.
# cleanup.py is cross-row and therefore runs once, after the merge.

set -euo pipefail

RUN_NAME=""
MODEL=""
MODEL_TYPE="elm"
PREFIX="elm"
FROM_STAGE=1
TO_STAGE=10
QA_ITERS=1
QA_ITERS_T1=""
QA_ITERS_T2=""
QA_ITERS_T3=""
ADV_ITERS=3
QA_MAX_TOKENS=2048
ADV_MAX_TOKENS=1024
TEMPERATURE=1
TOPIC_ATTEMPTS=3
NUMERIC_ATTEMPTS=3
SCENARIO_ITERS=0
REG_ATTEMPTS=3
SHARDS=1
MAX_PARALLEL=0
CLEANUP_THRESHOLD=0
QNO_MODE="global"

usage() {
	cat <<EOF
Usage: $0 -n <run_name> -m <model> [options]

Required:
  -n, --name            Run suffix, e.g. v7
  -m, --model           Model string, e.g. gpt-5.4-mini

Options:
  -t, --model-type      Default: elm
  -p, --prefix          Directory prefix. Default: elm
      --shards          Shards for stages 2-9. Default: 1 (no sharding)
      --max-parallel    Max shards running at once. Default: 0 (all of them)
      --from            First stage to run (1-10). Default: 1
      --to              Last stage to run (1-10). Default: 10
      --qa-iters        QA generation iterations per scenario. Default: 1
      --qa-iters-t1     Override --qa-iters for type1 only
      --qa-iters-t2     Override --qa-iters for type2 only
      --qa-iters-t3     Override --qa-iters for type3 only
      --adv-iters       Adversarial questions per QA pair. Default: 3
      --qa-max-tokens   Default: 2048
      --adv-max-tokens  Default: 1024
      --temperature     Default: 1
      --topic-attempts  topic_pregen_retry budget. Default: 3
      --reg-attempts    reg_pregen_retry budget. Default: 3
      --numeric-attempts numeric_pregen_retry budget. Default: 3
      --scenario-iters  Stage 1 self-expansion iterations. Default: 0 (seeded only)
      --threshold       cleanup.py -threshold. Must be 0 when sharded. Default: 0
      --qno-mode        Question_No renumbering at merge: global|perroot|keep. Default: global
EOF
	exit 1
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		-n|--name) RUN_NAME="$2"; shift 2 ;;
		-m|--model) MODEL="$2"; shift 2 ;;
		-t|--model-type) MODEL_TYPE="$2"; shift 2 ;;
		-p|--prefix) PREFIX="$2"; shift 2 ;;
		--shards) SHARDS="$2"; shift 2 ;;
		--max-parallel) MAX_PARALLEL="$2"; shift 2 ;;
		--from) FROM_STAGE="$2"; shift 2 ;;
		--to) TO_STAGE="$2"; shift 2 ;;
		--qa-iters) QA_ITERS="$2"; shift 2 ;;
		--qa-iters-t1) QA_ITERS_T1="$2"; shift 2 ;;
		--qa-iters-t2) QA_ITERS_T2="$2"; shift 2 ;;
		--qa-iters-t3) QA_ITERS_T3="$2"; shift 2 ;;
		--adv-iters) ADV_ITERS="$2"; shift 2 ;;
		--qa-max-tokens) QA_MAX_TOKENS="$2"; shift 2 ;;
		--adv-max-tokens) ADV_MAX_TOKENS="$2"; shift 2 ;;
		--temperature) TEMPERATURE="$2"; shift 2 ;;
		--topic-attempts) TOPIC_ATTEMPTS="$2"; shift 2 ;;
		--reg-attempts) REG_ATTEMPTS="$2"; shift 2 ;;
		--numeric-attempts) NUMERIC_ATTEMPTS="$2"; shift 2 ;;
		--scenario-iters) SCENARIO_ITERS="$2"; shift 2 ;;
		--threshold) CLEANUP_THRESHOLD="$2"; shift 2 ;;
		--qno-mode) QNO_MODE="$2"; shift 2 ;;
		-h|--help) usage ;;
		*) echo "Unknown option: $1"; usage ;;
	esac
done

[[ -z "$RUN_NAME" ]] && { echo "ERROR: -n/--name is required"; usage; }
[[ -z "$MODEL" ]] && { echo "ERROR: -m/--model is required"; usage; }

if ! [[ "$SHARDS" =~ ^[0-9]+$ ]] || [[ "$SHARDS" -lt 1 ]]; then
	echo "ERROR: --shards must be a positive integer"; exit 1
fi
if ! [[ "$MAX_PARALLEL" =~ ^[0-9]+$ ]]; then
	echo "ERROR: --max-parallel must be a non-negative integer"; exit 1
fi
for v in "$FROM_STAGE" "$TO_STAGE"; do
	if ! [[ "$v" =~ ^([1-9]|10)$ ]]; then
		echo "ERROR: --from/--to must be integers in 1-10 (got '$v')"; exit 1
	fi
done
if [[ "$FROM_STAGE" -gt "$TO_STAGE" ]]; then
	echo "ERROR: --from ($FROM_STAGE) is greater than --to ($TO_STAGE)"; exit 1
fi
if ! [[ "$SCENARIO_ITERS" =~ ^[0-9]+$ ]]; then
	echo "ERROR: --scenario-iters must be a non-negative integer"; exit 1
fi
if [[ "$SHARDS" -gt 1 && "$CLEANUP_THRESHOLD" -ne 0 ]]; then
	echo "ERROR: cleanup.py -threshold is cross-row. It must be 0 when --shards > 1."; exit 1
fi

# Resolve per-type QA iterations. An empty override falls back to --qa-iters.
QA_ITERS_T1="${QA_ITERS_T1:-$QA_ITERS}"
QA_ITERS_T2="${QA_ITERS_T2:-$QA_ITERS}"
QA_ITERS_T3="${QA_ITERS_T3:-$QA_ITERS}"
for v in "$QA_ITERS_T1" "$QA_ITERS_T2" "$QA_ITERS_T3"; do
	if ! [[ "$v" =~ ^[0-9]+$ ]]; then
		echo "ERROR: QA iterations must be non-negative integers (got '$v')"; exit 1
	fi
done
qa_iters_for() { case "$1" in 1) echo "$QA_ITERS_T1" ;; 2) echo "$QA_ITERS_T2" ;; 3) echo "$QA_ITERS_T3" ;; esac; }

# Types with zero QA iterations produce no stage-2 output, so every later stage
# must skip them too or it aborts on a missing directory.
ACTIVE_TYPES=()
for _t in 1 2 3
do
	[[ "$(qa_iters_for $_t)" -ne 0 ]] && ACTIVE_TYPES+=("$_t")
done
[[ ${#ACTIVE_TYPES[@]} -gt 0 ]] || { echo "ERROR: all three QA iteration counts are 0, nothing to run"; exit 1; }
echo "Types:      ${ACTIVE_TYPES[*]}"

if [[ "$MODEL_TYPE" == "elm" ]]; then
	[[ -z "${ELM_API_KEY:-}" ]] && { echo "ERROR: ELM_API_KEY is not set"; exit 1; }
	[[ -z "${ELM_BASE_URL:-}" ]] && { echo "ERROR: ELM_BASE_URL is not set"; exit 1; }
fi
if [[ "$MODEL_TYPE" == "gemini" ]]; then
	[[ -z "${GEMINI_API_KEY:-}" ]] && { echo "ERROR: GEMINI_API_KEY is not set"; exit 1; }
fi

SC="${PREFIX}-scenarios-${RUN_NAME}"
MANIFEST="generation_outputs/${SC}/shards.manifest"
LOG_DIR="generation_outputs/logs-${RUN_NAME}"

# $1 = type, $2 = shard suffix (may be empty)
qa_dir()   { echo "${PREFIX}-qa-type$1-${RUN_NAME}${2:-}"; }
adv_dir()  { echo "${PREFIX}-adv-type$1-${RUN_NAME}${2:-}"; }
docs_dir() { echo "${PREFIX}-docs-type$1-${RUN_NAME}${2:-}"; }

banner() {
	echo ""
	echo "=================================================================="
	echo "  STAGE $1 - $2"
	echo "=================================================================="
}

run_stage() { [[ "$1" -ge "$FROM_STAGE" && "$1" -le "$TO_STAGE" ]]; }

count() {
	python -c "
import pandas as pd, sys, os
p = sys.argv[1]
if not os.path.exists(p):
    print('  MISSING: ' + p); sys.exit(1)
print('  {}: {} rows'.format(os.path.basename(os.path.dirname(p)), len(pd.read_csv(p, sep='\t'))))
" "$1"
}

# Sums rows for one stage output across every shard. Never fails the run.
count_all() {
	# $1 = base dir name (no shard suffix), $2 = file stem
	python - "$1" "$2" "${SUFFIXES[@]}" <<'PYEOF' || true
import os, sys
import pandas as pd
base, stem = sys.argv[1], sys.argv[2]
sfxs = sys.argv[3:] or ['']
tot, found, missing = 0, 0, []
for s in sfxs:
    p = os.path.join('generation_outputs', base + s, stem + '.tsv')
    if not os.path.exists(p):
        missing.append(base + s)
        continue
    tot += len(pd.read_csv(p, sep='\t'))
    found += 1
msg = '  {}: {} rows across {} shard(s)'.format(base, tot, found)
if missing:
    msg += '  [MISSING: {}]'.format(', '.join(missing))
print(msg)
PYEOF
}

echo "Run name:   $RUN_NAME"
echo "Model:      $MODEL ($MODEL_TYPE)"
echo "Stages:     $FROM_STAGE to $TO_STAGE"
echo "Shards:     $SHARDS"
echo "QA iters:   t1=$QA_ITERS_T1  t2=$QA_ITERS_T2  t3=$QA_ITERS_T3"
echo "Scenarios:  $SC"

# ---------------------------------------------------------------- STAGE 1
if run_stage 1; then
	if [[ "$SCENARIO_ITERS" -eq 0 ]]; then
		banner 1 "Scenarios (seeded only, num_iters 0)"
	else
		banner 1 "Scenarios (seeded + self-expansion, num_iters $SCENARIO_ITERS)"
	fi
	python generator.py \
		-exp_type programmatic_scenarios \
		-prompt_type programmatic_scenarios \
		-model_type "$MODEL_TYPE" -model "$MODEL" \
		-max_tokens "$QA_MAX_TOKENS" -temperature "$TEMPERATURE" \
		-num_iters "$SCENARIO_ITERS" \
		-run_name "$SC"
	count "generation_outputs/${SC}/scenarios.tsv"
fi

# ------------------------------------------------------------ SHARD SPLIT
SUFFIXES=("")
if [[ "$SHARDS" -gt 1 && "$TO_STAGE" -ge 2 ]]; then
	if run_stage 2; then
		banner "1b" "Shard scenarios into $SHARDS parts"
		python shard_scenarios.py \
			-out_dir generation_outputs/ \
			-scenarios_name "$SC" \
			-shards "$SHARDS" \
			-manifest "$MANIFEST"
	fi
	[[ -f "$MANIFEST" ]] || { echo "ERROR: missing $MANIFEST. Run with --from 2 at least once."; exit 1; }
	SUFFIXES=()
	while IFS= read -r line; do
		[[ -n "$line" ]] && SUFFIXES+=("$line")
	done < "$MANIFEST"
	[[ ${#SUFFIXES[@]} -gt 0 ]] || { echo "ERROR: manifest is empty"; exit 1; }

	# Warm the tiktoken BPE cache once so concurrent shards do not race on the
	# same download. Mirrors generator.py's own resolution (model, else gpt-4).
	python -c "
import sys, tiktoken
try:
    tiktoken.encoding_for_model(sys.argv[1])
except Exception:
    tiktoken.encoding_for_model('gpt-4')
" "$MODEL" >/dev/null 2>&1 || true

	mkdir -p "$LOG_DIR"
fi

# Runs stages 2-9 for one shard suffix. Exits with the failing stage number so
# a sibling shard failure never aborts the others.
run_shard() {
	local sfx="$1"
	local sc="${SC}${sfx}"
	local t iters ADV_PROMPT ADV_EXP DOC_EXP

	if run_stage 2; then
		banner 2 "QA generation, types 1-3 [${sfx:-main}]"
		for t in 1 2 3; do
			iters="$(qa_iters_for $t)"
			if [[ "$iters" -eq 0 ]]; then
				echo "--- type$t: qa-iters 0, skipped ---"
				continue
			fi
			echo "--- type$t (num_iters $iters) ---"
			python generator.py \
				-exp_type programmatic_qa \
				-prompt_type "programmatic_qa_type${t}" \
				-scenarios_name "$sc" \
				-model_type "$MODEL_TYPE" -model "$MODEL" \
				-max_tokens "$QA_MAX_TOKENS" -temperature "$TEMPERATURE" \
				-num_iters "$iters" \
				-reg_pregen_max_attempts "$REG_ATTEMPTS" \
				-numeric_pregen_max_attempts "$NUMERIC_ATTEMPTS" \
				-topic_pregen_max_attempts "$TOPIC_ATTEMPTS" \
				-run_name "$(qa_dir $t "$sfx")" || exit 2
		done
		for t in 1 2 3; do count "generation_outputs/$(qa_dir $t "$sfx")/prog_qa.tsv" || true; done
	fi

	if run_stage 3; then
		banner 3 "post_process QA [${sfx:-main}]"
		python post_process.py -exp_type programmatic_qa       -folder_name "$(qa_dir 1 "$sfx")" -data prog_qa || exit 3
		python post_process.py -exp_type programmatic_qa       -folder_name "$(qa_dir 2 "$sfx")" -data prog_qa || exit 3
		python post_process.py -exp_type programmatic_qa_type3 -folder_name "$(qa_dir 3 "$sfx")" -data prog_qa || exit 3
	    for t in 1 2 3; do count "generation_outputs/$(qa_dir $t "$sfx")/prog_qa_modified.tsv" || true; done
 	fi

	if run_stage 4; then
		banner 4 "Adversarial generation [${sfx:-main}]"
		for t in 1 2 3; do
			if [[ "$t" == "3" ]]; then ADV_PROMPT="programmatic_adversarial_type3"; else ADV_PROMPT="programmatic_adversarial"; fi
			python generator.py \
				-exp_type programmatic_adversarial \
				-prompt_type "$ADV_PROMPT" \
				-questions_name "$(qa_dir $t "$sfx")" \
				-model_type "$MODEL_TYPE" -model "$MODEL" \
				-max_tokens "$ADV_MAX_TOKENS" -temperature "$TEMPERATURE" \
				-num_iters "$ADV_ITERS" \
				-run_name "$(adv_dir $t "$sfx")" || exit 4
		done
        for t in 1 2 3; do count "generation_outputs/$(adv_dir $t "$sfx")/prog_qa.tsv" || true; done
 	fi

	if run_stage 5; then
		banner 5 "post_process adversarial [${sfx:-main}]"
		for t in 1 2 3; do
			if [[ "$t" == "3" ]]; then ADV_EXP="programmatic_adversarial_type3"; else ADV_EXP="programmatic_adversarial"; fi
			python post_process.py -exp_type "$ADV_EXP" -folder_name "$(adv_dir $t "$sfx")" -data prog_qa || exit 5
 		done
        for t in 1 2 3; do count "generation_outputs/$(adv_dir $t "$sfx")/prog_qa_modified.tsv" || true; done
	fi

	if run_stage 6; then
		banner 6 "Adversarial verify [${sfx:-main}]"
		for t in 1 2 3; do
			python verification.py \
				-exp_type programmatic_adversarial \
				-folder_name "$(adv_dir $t "$sfx")" -data prog_qa_modified \
				-model_type "$MODEL_TYPE" -model "$MODEL" || exit 6
		done
        for t in 1 2 3; do count "generation_outputs/$(adv_dir $t "$sfx")/prog_qa_modified_verified.tsv" || true; done
	fi

	if run_stage 7; then
		banner 7 "Document generation [${sfx:-main}]"
		for t in 1 2 3; do
			python generator.py \
				-exp_type programmatic_docs \
				-prompt_type programmatic_docs \
				-adversarial_name "$(adv_dir $t "$sfx")" \
				-model_type "$MODEL_TYPE" -model "$MODEL" \
				-temperature "$TEMPERATURE" \
				-run_name "$(docs_dir $t "$sfx")" || exit 7
		done
        for t in 1 2 3; do count "generation_outputs/$(docs_dir $t "$sfx")/programmatic_data.tsv" || true; done
	fi

	if run_stage 8; then
		banner 8 "post_process docs [${sfx:-main}]"
		for t in 1 2 3; do
			python post_process.py -exp_type programmatic_docs -folder_name "$(docs_dir $t "$sfx")" -data programmatic_data || exit 8
		done
        for t in 1 2 3; do count "generation_outputs/$(docs_dir $t "$sfx")/programmatic_data_modified.tsv" || true; done
	fi

	if run_stage 9; then
		banner 9 "Document verify [${sfx:-main}]"
		for t in 1 2 3; do
			if [[ "$t" == "3" ]]; then DOC_EXP="programmatic_docs_type3"; else DOC_EXP="programmatic_docs"; fi
			python verification.py \
				-exp_type "$DOC_EXP" \
				-folder_name "$(docs_dir $t "$sfx")" -data programmatic_data_modified \
				-model_type "$MODEL_TYPE" -model "$MODEL" || exit 9
		done
        for t in 1 2 3; do count "generation_outputs/$(docs_dir $t "$sfx")/programmatic_data_modified_verified.tsv" || true; done
	fi

	exit 0
}

# --------------------------------------------------- STAGES 2-9 EXECUTION
if [[ "$FROM_STAGE" -le 9 && "$TO_STAGE" -ge 2 ]]; then
	if [[ "$SHARDS" -eq 1 ]]; then
		( run_shard "" ) < /dev/null
	else
		PIDS=()
		NAMES=()
		[[ "$MAX_PARALLEL" -gt 0 ]] && echo "throttling to $MAX_PARALLEL concurrent shards"
		for sfx in "${SUFFIXES[@]}"; do
			if [[ "$MAX_PARALLEL" -gt 0 ]]; then
				while [[ "$(jobs -rp | wc -l)" -ge "$MAX_PARALLEL" ]]; do sleep 5; done
			fi
			( run_shard "$sfx" ) < /dev/null > "${LOG_DIR}/shard${sfx}.log" 2>&1 &
			PIDS+=($!)
			NAMES+=("$sfx")
			echo "launched shard ${sfx} (pid $!) -> ${LOG_DIR}/shard${sfx}.log"
		done

		FAILED=()
		for i in "${!PIDS[@]}"; do
			rc=0
			wait "${PIDS[$i]}" || rc=$?
			if [[ "$rc" -eq 0 ]]; then
				echo "  ${NAMES[$i]}: OK"
			else
				echo "  ${NAMES[$i]}: FAILED at stage $rc"
				FAILED+=("${NAMES[$i]}:$rc")
			fi
		done

		if [[ ${#FAILED[@]} -gt 0 ]]; then
			echo ""
			echo "SHARD FAILURES: ${FAILED[*]}"
			echo ""
			echo "Inspect ${LOG_DIR}/shard<sfx>.log, then rerun that shard with --from <stage>."
			echo "Stage 2 has no resume and overwrites prog_qa.tsv, so a stage-2 rerun"
			echo "restarts that shard's QA generation from scratch (no duplication)."
			exit 1
		fi
	fi
    # -------------------------------------------------- CROSS-SHARD SUMMARY
    if [[ "$FROM_STAGE" -le 9 && "$TO_STAGE" -ge 2 ]]; then
        echo ""
        echo "------------------------- row counts by stage --------------------"
        run_stage 2 && { echo "stage 2 (prog_qa):";                    for t in 1 2 3; do count_all "$(qa_dir $t)"   prog_qa; done; }
        run_stage 3 && { echo "stage 3 (prog_qa_modified):";           for t in 1 2 3; do count_all "$(qa_dir $t)"   prog_qa_modified; done; }
        run_stage 4 && { echo "stage 4 (adv prog_qa):";                for t in 1 2 3; do count_all "$(adv_dir $t)"  prog_qa; done; }
        run_stage 5 && { echo "stage 5 (adv prog_qa_modified):";       for t in 1 2 3; do count_all "$(adv_dir $t)"  prog_qa_modified; done; }
        run_stage 6 && { echo "stage 6 (adv verified):";               for t in 1 2 3; do count_all "$(adv_dir $t)"  prog_qa_modified_verified; done; }
        run_stage 7 && { echo "stage 7 (programmatic_data):";          for t in 1 2 3; do count_all "$(docs_dir $t)" programmatic_data; done; }
        run_stage 8 && { echo "stage 8 (programmatic_data_modified):"; for t in 1 2 3; do count_all "$(docs_dir $t)" programmatic_data_modified; done; }
        run_stage 9 && { echo "stage 9 (docs verified):";              for t in 1 2 3; do count_all "$(docs_dir $t)" programmatic_data_modified_verified; done; }
        echo "------------------------------------------------------------------"
    fi
fi

# ------------------------------------------------------------------ MERGE
if [[ "$SHARDS" -gt 1 ]] && run_stage 9; then
	banner "9b" "Merge shards and renumber positional IDs"
	for t in 1 2 3; do
		python merge_shards.py \
			-out_dir generation_outputs/ \
			-base_name "$(docs_dir $t)" \
			-scenarios_name "$SC" \
			-manifest "$MANIFEST" \
			-data programmatic_data_modified_verified \
			-qno_mode "$QNO_MODE"
	done
	for t in 1 2 3; do count "generation_outputs/$(docs_dir $t)/programmatic_data_modified_verified.tsv"; done
fi

# ---------------------------------------------------------------- STAGE 10
if run_stage 10; then
	banner 10 "Cleanup (unsharded, cross-row)"
	for t in 1 2 3; do
		python cleanup.py \
			-out_dir "generation_outputs/$(docs_dir $t)/" \
			-og_data programmatic_data_modified_verified \
			-seed_data programmatic_data_modified_verified \
			-threshold "$CLEANUP_THRESHOLD" < /dev/null
	done
	for t in 1 2 3; do count "generation_outputs/$(docs_dir $t)/programmatic_data_modified_verified_cleaned.tsv"; done
fi

echo ""
echo "=================================================================="
echo "  Pipeline finished: stages $FROM_STAGE-$TO_STAGE, run $RUN_NAME, shards $SHARDS"
echo "=================================================================="
echo ""
echo "RocketEval next:"
for t in 1 2 3; do
	echo "  python checklist_generator.py -out_dir generation_outputs/ -folder_name $(docs_dir $t) -qa_type type$t -model_type $MODEL_TYPE -model $MODEL"
	echo "  # judge_panel.py appends (mode='a'). Delete its output before any rerun or rows duplicate."
	echo "  python judge_panel.py -out_dir generation_outputs/ -folder_name $(docs_dir $t)"
	echo "  python poll_aggregate.py -out_dir generation_outputs/ -folder_name $(docs_dir $t) -unsure exclude -pass_frac 0.75 -disagree_frac 0.34"
done